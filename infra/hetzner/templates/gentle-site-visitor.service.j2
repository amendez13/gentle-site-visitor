[Unit]
Description=gentle-site-visitor application service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gentle-site-visitor
Group=gentle-site-visitor
WorkingDirectory=/opt/gentle-site-visitor
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/gentle-site-visitor/venv/bin/python -m src.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
SyslogIdentifier=gentle-site-visitor

[Install]
WantedBy=multi-user.target
